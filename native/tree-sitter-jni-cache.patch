+        static const char *node_types[] = {"I", "I", "I", "I", "J", "J"};
+        static const char *point_names[] = {"row", "column"};
+        static const char *point_types[] = {"I", "I"};
+        ts_node_class_cache = ts_jni_cache_class(env, TS_NODE_CLASS_NAME, node_names, node_types, ts_node_fields, 6);
+        ts_point_class_cache = ts_jni_cache_class(env, TS_POINT_CLASS_NAME, point_names, point_types, ts_point_fields, 2);
+    }
     return JNI_VERSION_10;
 }
 
