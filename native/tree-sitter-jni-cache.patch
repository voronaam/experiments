+
+/*
+ * CodeCity patch: TSNode and TSPoint cross the JNI boundary on every node access, and looking their class and field
+ * ids up each time (FindClass plus one GetFieldID per field) cost more than the tree-sitter call itself. They are
+ * resolved once in JNI_OnLoad instead. Class and field ids stay valid as long as the class is loaded, and the class
+ * is pinned by the global reference. If the lookup fails, the cache stays empty and every conversion falls back to
+ * the per-call lookup of the original code.
+ */
+static jclass ts_node_class_cache = NULL;
+static jfieldID ts_node_fields[6]; /* context0..3, idPtr, treePtr */
+static jclass ts_point_class_cache = NULL;
+static jfieldID ts_point_fields[2]; /* row, column */
+
+static jclass ts_jni_cache_class(JNIEnv *env, const char *class_name, const char **names, const char **types,
+                                 jfieldID *ids, int count){
+    jclass local = (*env)->FindClass(env, class_name);
+    if (local == NULL) {
+        (*env)->ExceptionClear(env);
+        return NULL;
+    }
+    for (int i = 0; i < count; i++) {
+        ids[i] = (*env)->GetFieldID(env, local, names[i], types[i]);
+        if (ids[i] == NULL) {
+            (*env)->ExceptionClear(env);
+            (*env)->DeleteLocalRef(env, local);
+            return NULL;
+        }
+    }
+    jclass global = (jclass) (*env)->NewGlobalRef(env, local);
+    (*env)->DeleteLocalRef(env, local);
+    return global;
+}
